# chord-token-risk-scanner: copy to .env and edit. Every line is optional.

# Chain key or id.
CHAIN=base

# Comma list of symbols or 0x addresses to check.
WATCH_TOKENS=

# Chord API base URL.
CHORD_API=https://api.getchord.xyz/v1

# Optional. Not needed for anything this agent calls.
CHORD_API_KEY=

# Client-side request cap per minute (anonymous callers get 60 per IP).
CHORD_RPM=50
